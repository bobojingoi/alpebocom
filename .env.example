# ===== SITE (frontend + /api) — pe Vercel se setează pe proiectul SITE-ului =====

# Alpebo Hub — sursa conținutului (CMS, articole). Fără el, build-ul folosește DEFAULT_CONTENT.
HUB_URL=https://alpebo-hub.vercel.app
# 0 = sari peste aducerea conținutului la build (dev offline)
HUB_SNAPSHOT=1

# Formularul „Cere ofertă de preț" → email de notificare prin Resend.
# Fără cheie: /api/lead rulează dry-run (loghează, dar nu trimite nimic).
RESEND_API_KEY=
EMAIL_FROM=Alpebocom <noreply@alpebocom.ro>
EMAIL_TO=contact@alpebocom.ro

# Secret partajat site → hub pentru POST /api/v1/leads.
# Se setează IDENTIC și pe proiectul Hub (vezi hub/.env.example).
LEADS_SYNC_SECRET=
