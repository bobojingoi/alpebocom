# ===== ALPEBO HUB — pe Vercel se setează pe proiectul HUB-ului (separat de site!) =====

# Postgres (Supabase). Fără el, hub-ul rulează cu stocare în memorie (doar dev).
DATABASE_URL=
# 0 = fără SSL (Postgres local)
DATABASE_SSL=

# Tokenul de admin (schelet). TODO pe board: utilizatori + sesiuni reale.
ADMIN_TOKEN=

# Secret partajat site -> hub pentru POST /api/v1/leads.
# Identic cu LEADS_SYNC_SECRET de pe proiectul site-ului.
LEADS_SYNC_SECRET=

# Originile care pot chema API-ul din browser
CORS_ORIGINS=https://alpebocom.ro,https://www.alpebocom.ro,http://localhost:5173

PORT=4000
